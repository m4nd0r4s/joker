; spec/cddl/secrets.cddl — secrets (docs/ref/02-lock-node-and-client.md, §2.4 and §3.4)
;
; Everything is deterministic CBOR (RFC 8949, §4.2.1). The *-aad and *-payload structures never
; travel: they are serialized and used as AAD or as the detached payload of COSE_Sign1.
; secret-bundle is the set delivered to a node (media type joker.secrets.v1),
; with integer keys. Keys 1–99: v1. Negative keys: private extensions, ignored.
; No key is reused after it is removed (ref/00, §1).

secret-name  = tstr .regexp "[a-z][a-z0-9_]{0,63}|link\\.[a-z][a-z0-9_]{0,31}"   ; link.<device>: Joker Link key (ref/02 §2.4.8)
recipient-id = tstr .regexp "(node|user):[a-z0-9]([a-z0-9._-]{0,61}[a-z0-9])?"
rev          = uint .ge 1
secret-type  = "string" / "bytes"
sha256       = bstr .size 32
kid          = bstr .size 16            ; first 16 bytes of the SHA-256 of the raw public key

; AAD of the value encryption (ChaCha20-Poly1305, key = DEK)
secret-value-aad = [
  tag: "joker-secret/1",
  name: secret-name,
  rev: rev,
  type: secret-type,
]

; AAD of the DEK encryption for a recipient (HPKE base, 0x0020 / 0x0001 / 0x0003;
; info = "joker-secret/1")
secret-wrap-aad = [
  tag: "joker-secret-wrap/1",
  name: secret-name,
  rev: rev,
  recipient: recipient-id,
]

; detached payload of the signature (COSE_Sign1, alg EdDSA -8, kid in the protected header)
secret-sig-payload = [
  tag: "joker-secret-sig/1",
  name: secret-name,
  rev: rev,
  type: secret-type,
  value: sha256,                        ; SHA-256(nonce || ciphertext)
]

; set delivered to a node or to a standalone MCU: only that recipient's wrap.
; Travels in jk apply / jk secret push, in key 22 of the Deck's desired state (ref/10 §2.6) and in a
; section of the generation blob of a standalone MCU (ref/08). Each entry is signed by the `secrets` role.
; In the API (ref/09, SealedSecret): `sealed` = base64 of a secret-entry; `key_id` = id of the node's
; KEM key ("x25519:<32 hex>"); `scheme` = the `suite` of secrets.toml.enc (ref/02 §2.4.9).
secret-bundle = {
  1 => 1,                               ; format version
  2 => recipient-id,                    ; intended recipient
  3 => [* secret-entry],                ; sorted by name
  * nint => any,
}

secret-entry = {
  1 => secret-name,
  2 => rev,
  3 => secret-type,
  4 => bstr .size 12,                   ; nonce
  5 => bstr,                            ; ciphertext || tag (16 B)
  6 => bstr .size 80,                   ; wrap: enc (32 B) || ct (48 B)
  ? 7 => kid,                           ; signer (required in prod)
  ? 8 => bstr,                          ; sig: COSE_Sign1 with detached payload
  * nint => any,
}
