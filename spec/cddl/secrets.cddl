; spec/cddl/secrets.cddl — segredos (docs/ref/02-lock-node-and-client.md, §2.4 e §3.4)
;
; Tudo é CBOR determinístico (RFC 8949, §4.2.1). As estruturas *-aad e *-payload nunca
; viajam: são serializadas e usadas como AAD ou como payload destacado de COSE_Sign1.
; secret-bundle é o conjunto entregue a um nó (tipo de media joker.secrets.v1),
; com chaves inteiras. Chaves 1–99: v1. Chaves negativas: extensões privadas, ignoradas.
; Nenhuma chave se reutiliza depois de removida (ref/00, §1).

secret-name  = tstr .regexp "[a-z][a-z0-9_]{0,63}|link\\.[a-z][a-z0-9_]{0,31}"   ; link.<device>: Joker Link key (ref/02 §2.4.8)
recipient-id = tstr .regexp "(node|user):[a-z0-9]([a-z0-9._-]{0,61}[a-z0-9])?"
rev          = uint .ge 1
secret-type  = "string" / "bytes"
sha256       = bstr .size 32
kid          = bstr .size 16            ; 16 primeiros bytes do SHA-256 da chave pública crua

; AAD da cifra do valor (ChaCha20-Poly1305, chave = DEK)
secret-value-aad = [
  tag: "joker-secret/1",
  name: secret-name,
  rev: rev,
  type: secret-type,
]

; AAD da cifra da DEK para um destinatário (HPKE base, 0x0020 / 0x0001 / 0x0003;
; info = "joker-secret/1")
secret-wrap-aad = [
  tag: "joker-secret-wrap/1",
  name: secret-name,
  rev: rev,
  recipient: recipient-id,
]

; payload destacado da assinatura (COSE_Sign1, alg EdDSA -8, kid no cabeçalho protegido)
secret-sig-payload = [
  tag: "joker-secret-sig/1",
  name: secret-name,
  rev: rev,
  type: secret-type,
  value: sha256,                        ; SHA-256(nonce || ciphertext)
]

; conjunto entregue a um nó ou a um MCU autónomo: só o wrap desse destinatário.
; Viaja no jk apply / jk secret push, na chave 22 do estado desejado do Deck (ref/10 §2.6) e numa
; secção do blob de geração de um MCU autónomo (ref/08). Cada entrada é assinada pelo papel `secrets`.
; Na API (ref/09, SealedSecret): `sealed` = base64 de uma secret-entry; `key_id` = id da chave KEM
; do nó ("x25519:<32 hex>"); `scheme` = o `suite` do secrets.toml.enc (ref/02 §2.4.9).
secret-bundle = {
  1 => 1,                               ; versão do formato
  2 => recipient-id,                    ; a quem se destina
  3 => [* secret-entry],                ; ordenadas por nome
  * nint => any,
}

secret-entry = {
  1 => secret-name,
  2 => rev,
  3 => secret-type,
  4 => bstr .size 12,                   ; nonce
  5 => bstr,                            ; ciphertext || etiqueta (16 B)
  6 => bstr .size 80,                   ; wrap: enc (32 B) || ct (48 B)
  ? 7 => kid,                           ; signer (obrigatório em prod)
  ? 8 => bstr,                          ; sig: COSE_Sign1 com payload destacado
  * nint => any,
}
