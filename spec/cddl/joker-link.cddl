; =============================================================================
; Joker Link v1.0 — corpos das mensagens, catálogo e manifesto de OTA
; Referência: docs/ref/07-joker-link.md (normativa). RFC 8610 (CDDL).
;
; - O cabeçalho da trama (L2, ref/07 §4.1) e o cabeçalho da mensagem
;   (ref/07 §5.1) são BINÁRIOS e não estão descritos aqui.
; - Cada corpo é um único item CBOR (um mapa com chaves inteiras), ou vazio
;   (0 bytes) no ACK.
; - Emissores: CBOR determinístico (RFC 8949 §4.2.1). Leitores: aceitam
;   qualquer codificação bem formada, ignoram chaves desconhecidas e mapeiam
;   valores de enum desconhecidos para "desconhecido" (ref/00 §1).
; - O tipo da mensagem vem do cabeçalho; "link-body" só agrupa os corpos.
; =============================================================================

link-body = hello / ready / bye / ping / pong / ack / error / keyrot /
            catalog-msg / read / samples / propose / outcomes / call /
            action / result / cancel / events / alarms / alarm-cmd / reset /
            restart / time / trace / ota

; ---------------------------------------------------------------- tipos base
u8   = 0..255
u16  = 0..65535
u32  = 0..4294967295
u64  = 0..18446744073709551615
i32  = -2147483648..2147483647
s64  = -9223372036854775808..9223372036854775807
hash32  = bstr .size 32            ; SHA-256
nonce16 = bstr .size 16
kid8    = bstr .size 8             ; kid da K_link (ref/07 §4.2)
kid16   = bstr .size 16            ; kid de uma chave de assinatura: SHA-256(chave pública)[0..16] (ref/02 §2.5)
path-hash = u64                    ; primeiros 8 B do SHA-256 do caminho canónico (ref/00 §5)
mono-us = u64                      ; monotónico do MCU, µs desde o arranque
host-us = u64                      ; monotónico do nó Linux, µs (só em TIME)
utc-us  = s64                      ; UTC, µs desde 1970-01-01T00:00:00Z
dur-ms  = u32                      ; duração em ms
sid     = u32                      ; SignalId na geração do MCU
level   = 1..16                    ; nível do árbitro (1 = mais alto)
origin  = u32                      ; escritor do nó Linux (ref/00 §5); informativo
quality = u32                      ; código | motivo << 8 | flags << 16 (ref/00 §4.3)
status  = uint                     ; ref/07 §10.1
link-version = [major: u8, minor: u8]
idem-key = tstr .regexp "[ -~]{1,64}"   ; ASCII imprimível, 1–64 B (ref/00 §5)

; valor de um sinal (ref/07 §6.1); o tipo real vem do catálogo
value  = bool / int / float / tstr .size (0..64) / bstr .size (0..64)
; registo (argumentos, resultados, eventos): chaves inteiras = posição do campo no esquema,
; a contar de 0 (D2, ref/00 §4.1, ref/04 §4.10)
record = { * uint => any }

writer-kind   = &(cycle: 0, async: 1, manual: 2, bridge: 3, impl: 4, proposal: 5) / uint
role          = &(viewer: 0, operator: 1, admin: 2) / uint
outcome       = &(none: 0, accepted: 1, clamped_range: 2, clamped_rate: 3,
                  suppressed: 4, overridden: 5, deferred: 6, shadowed: 7,
                  rejected: 8, tripped: 9) / uint
reject-reason = &(wrong_type: 1, interlock: 2, quality: 3, range: 4,
                  atomic_group: 5, not_owner: 6, clock_unsynced: 7, budget: 8) / uint
alarm-state   = &(normal: 0, active_unacked: 1, active_acked: 2,
                  rtn_unacked: 3, unknown: 4) / uint
severity      = &(low: 0, medium: 1, high: 2, critical: 3) / uint
clock-quality = &(synced: 0, holdover: 1, unsynced: 2) / uint
clock-source  = &(none: 0, ntp: 1, ptp: 2, gnss: 3, manual: 4) / uint
gen-state     = &(pending: 0, confirming: 1, confirmed: 2, rolled_back: 3, failed: 4,
                  discarded: 5) / uint
sig-type      = &(bool: 0, i64: 1, u64: 2, f64: 3, f32: 4, enum: 5, bits: 6,
                  string: 7, bytes: 8) / uint
session-mode  = &(full: 0, observe: 1, maintenance: 2, refused: 3) / uint

; ------------------------------------------------------------------ HELLO 0x01
hello = hello-offer / hello-answer / hello-request

hello-offer = {                    ; MCU -> nó Linux
  1 => 0,                          ; fase: oferta
  2 => [+ [major: u8, max-minor: u8]],
  3 => nonce16,                    ; nonce_d
  4 => identity,
  5 => firmware-info,
  ? 6 => generation-info,          ; ausente: MCU sem geração válida
  ? 7 => hash32,                   ; hash do registo (16 §7)
  ? 8 => hash32,                   ; hash do catálogo (ref/07 §6.2)
  ? 9 => [* contract-ref],
  ? 10 => bool,                    ; true: a lista 9 está truncada
  11 => caps,
  12 => boot-info,
  13 => mono-us,                   ; agora, no MCU
  ? 14 => bstr .size 32,           ; RESERVADO 1.x: chave pública X25519 efémera
  ? 15 => hash32,                  ; drivers planeados: SHA-256 de [* [nome, major, digest do descritor]]
  ? 16 => [* [path-hash, value]],  ; parâmetros substituídos localmente (≤ 8)
  ? 17 => bool,                    ; true: há mais parâmetros alterados do que os da chave 16
  * uint => any
}

hello-answer = {                   ; nó Linux -> MCU
  1 => 1,                          ; fase: resposta
  2 => link-version,               ; versão escolhida
  3 => nonce16,                    ; nonce_h
  4 => nonce16,                    ; eco do nonce_d
  5 => session-mode,
  ? 6 => u32,                      ; session id (≠ 0); ausente se refused
  ? 7 => session-params,           ; ausente se refused
  ? 8 => status,
  ? 9 => tstr,                     ; código do registo (J-E22xx)
  ? 10 => tstr,                    ; detalhe
  ? 14 => bstr .size 32,           ; RESERVADO 1.x
  * uint => any
}

hello-request = {                  ; nó Linux -> MCU: "recomeça o handshake"
  1 => 2,
  ? 8 => status,
  * uint => any
}

identity = {
  1 => tstr,                       ; nome do MCU (rótulo DNS, ref/00 §5)
  2 => bstr .size (4..32),         ; identificador único de hardware
  ? 3 => tstr,                     ; placa
  * uint => any
}

firmware-info = {
  1 => tstr,                       ; versão SemVer
  2 => hash32,                     ; digest da imagem
  ? 3 => tstr,                     ; alvo (família de firmware / placa)
  ? 4 => [u8, u8],                 ; JK_ABI_VERSION_MAJOR, _MINOR (ref/08)
  ? 5 => hash32,                   ; hash da tabela de capacidades (ref/08)
  ? 6 => tstr,                     ; versão do Joker Micro (runtime), SemVer
  ? 7 => [* tstr],                 ; features compiladas, ordenadas (ref/02 [mcu])
  ? 8 => capacity,
  ? 9 => hash32,                   ; SHA-256 do descritor de firmware (firmware.jkfw, ref/08 §2.14)
  ? 10 => u32,                     ; security_version confirmado (anti-rollback)
  * uint => any
}
capacity = {                       ; cap_id -> valor, numeração da ref/08 §2.13.3
  ? 1 => u32,                      ; signals
  ? 3 => u32,                      ; outputs
  ? 4 => u32,                      ; groups
  ? 16 => u32,                     ; instances
  ? 36 => u32,                     ; trace_bytes
  ? 37 => u32,                     ; kv_bytes
  * (1..40) => u32                 ; as restantes capacidades, se couberem
}

generation-info = {
  1 => u64,                        ; gen_seq do blob
  2 => hash32,                     ; hash da geração (source_hash do blob, ref/08 §2.13.2)
  3 => gen-state,
  4 => &(embedded: 0, flash: 1) / uint,
  * uint => any
}

contract-ref = [class: tstr, version: tstr, contract: hash32]

caps = {
  1 => u16,                        ; max_frame que o MCU recebe
  2 => u16,                        ; max_msg (mensagem remontada)
  3 => u8,                         ; janela fiável de receção
  4 => uint,                       ; features (ref/07 §6.4.1)
  5 => u8,                         ; capacidade da tabela de deduplicação
  6 => u8,                         ; capacidade de escritores remotos (saída, nível)
  ? 7 => u32,                      ; bytes do anel de traço
  * uint => any
}

boot-info = {
  1 => u32,                        ; contador de arranques
  2 => reset-reason,
  3 => 0..1,                       ; slot de firmware ativo (A = 0, B = 1)
  4 => bool,                       ; firmware em experiência (trial)
  5 => gen-state,                  ; resultado da última atualização de firmware
  ? 6 => 0..1,                     ; slot de geração ativo
  ? 7 => bool,                     ; geração em experiência
  ? 8 => dur-ms,                   ; tempo restante da janela de confirmação
  * uint => any
}
reset-reason = &(unknown: 0, power_on: 1, pin: 2, watchdog: 3, software: 4,
                 brownout: 5, ota: 6, fault: 7) / uint

session-params = {
  1 => u16,                        ; max_frame
  2 => u16,                        ; max_msg
  3 => u8,                         ; window
  4 => dur-ms,                     ; keepalive
  5 => dur-ms,                     ; link_timeout
  6 => dur-ms,                     ; report
  7 => dur-ms,                     ; refresh (0 = desligado)
  8 => dur-ms,                     ; max_lease
  9 => dur-ms,                     ; rto_min
  10 => u8,                        ; retransmit (reenvios de uma mensagem F)
  11 => dur-ms,                    ; ack_delay
  12 => dur-ms,                    ; time_interval (0 = sem TIME)
  13 => u16,                       ; bulk_max
  ? 14 => u8,                      ; turn_frames (só half-duplex)
  * uint => any
}

; ------------------------------------------------------------------ READY 0x02
ready = { 1 => session-mode, 2 => mono-us, * uint => any }

; -------------------------------------------------------------------- BYE 0x03
bye = { 1 => bye-reason, ? 2 => tstr, ? 3 => tstr, * uint => any }
bye-reason = &(shutdown: 0, rehandshake: 1, generation_change: 2, reboot: 3,
               ota_activate: 4, error: 5) / uint

; -------------------------------------------------------- PING 0x04, PONG 0x05
ping = { 1 => u64, * uint => any }                    ; t: µs, relógio de quem envia
pong = { 1 => u64, 2 => u64, * uint => any }          ; eco de t; t de quem responde

; -------------------------------------------------------------------- ACK 0x06
ack = {}                                              ; corpo vazio (0 bytes) ou mapa vazio

; ------------------------------------------------------------------ ERROR 0x07
error = {
  1 => status,
  ? 2 => tstr,                     ; código do registo ("J-E2310")
  ? 3 => u8,                       ; tipo da mensagem que o causou
  ? 4 => u16,                      ; seq do pacote que o causou
  ? 5 => u16,                      ; rseq, se era fiável
  ? 6 => tstr,                     ; detalhe (≤ 128 B)
  * uint => any
}

; ----------------------------------------------------------------- KEYROT 0x08
keyrot = keyrot-offer / keyrot-stored
keyrot-offer  = { 1 => 0, 2 => kid8, 3 => bstr .size 32, * uint => any }   ; nó Linux -> MCU
keyrot-stored = { 1 => 1, 2 => kid8, * uint => any }                      ; MCU -> nó Linux

; ---------------------------------------------------------------- CATALOG 0x10
catalog-msg = catalog-req / catalog-data
catalog-req  = { 1 => 0, 2 => u32, 3 => u16, * uint => any }            ; offset, maxlen
catalog-data = { 1 => 1, 2 => u32, 3 => u32, 4 => bstr, * uint => any } ; offset, total, bytes

; ------------------------------------------------------------------- READ 0x11
read = {
  ? 1 => [* sid],                  ; ausente: todos os sinais
  ? 2 => bool,                     ; true: também um snapshot de ALARMS
  * uint => any
}

; ---------------------------------------------------------------- SAMPLES 0x12
samples = {
  1 => mono-us,                    ; t0: base de tempo do lote
  2 => [* sample],
  ? 3 => uint,                     ; flags: bit 0 refresh, bit 1 resposta a READ, bit 2 última da resposta
  ? 4 => u16,                      ; rseq do READ a que responde
  ? 5 => u32,                      ; amostras coalescidas (substituídas antes do envio)
  * uint => any
}
sample = [
  sid,
  seq: u16,                        ; 16 bits baixos da seq do MCU
  v: value,
  ? dt: u32,                       ; µs depois de t0 (omissão 0)
  ? q: quality,                    ; omissão 0 (good, none, sem flags)
  ? ts-src: utc-us / null,         ; UTC da origem, se existir
  * any
]

; ---------------------------------------------------------------- PROPOSE 0x13
propose = { 1 => [+ writer-block], * uint => any }
writer-block = [
  origin,
  level,
  kind: writer-kind,
  lease: dur-ms,                   ; 1 ≤ lease ≤ max_lease da sessão
  props: [* prop],
  ? calls: [* call-rec],           ; registos de método (17 §4.1)
  * any
]
prop = [
  sid,
  v: value / null,                 ; null = relinquish nesse nível
  ? at: mono-us,                   ; RESERVADO 1.1 (escritas agendadas, M6)
  * any
]
call-rec = [mid: u16, args: record / null, * any]

; --------------------------------------------------------------- OUTCOMES 0x14
outcomes = {
  1 => u16,                        ; ref: seq do último PROPOSE consumido
  2 => mono-us,                    ; t do tick do MCU
  3 => [* outcome-entry],
  ? 4 => [* expired-entry],        ; leases remotos que expiraram neste tick
  ? 5 => u32,                      ; resultados perdidos (janela cheia)
  * uint => any
}
outcome-entry = [
  sid, origin, level,
  o: outcome,
  ? applied: value / null,         ; valor aplicado; null = igual ao proposto
  ? detail: reject-reason / level, ; rejected: motivo; overridden: nível ativo
  * any
]
expired-entry = [sid, origin, level, * any]

; ------------------------------------------------------------------- CALL 0x15
call = {
  1 => u32,                        ; id do pedido
  2 => u16,                        ; mid (catálogo)
  3 => origin,
  4 => level,
  5 => writer-kind,
  6 => dur-ms,                     ; lease das escritas expandidas
  ? 7 => record,                   ; argumentos
  ? 8 => idem-key,
  * uint => any
}

; ----------------------------------------------------------------- ACTION 0x16
action = {
  1 => u32,                        ; id do pedido
  2 => u16,                        ; aid (catálogo)
  ? 3 => record,                   ; argumentos
  4 => idem-key,
  5 => role,                       ; papel de quem pediu (verificado no nó Linux)
  ? 6 => dur-ms,                   ; timeout pedido (≤ o do MCU)
  * uint => any
}

; ----------------------------------------------------------------- RESULT 0x17
result = {
  1 => u32,                        ; id do pedido (CALL, ACTION, ALARM_CMD, RESET, RESTART)
  2 => result-state,
  ? 3 => any,                      ; valor de Ok(...) (registo ou null)
  ? 4 => status,
  ? 5 => tstr,                     ; código do registo
  ? 6 => 0..100,                   ; progresso (running)
  ? 7 => [* outcome-entry],        ; CALL: resultados das escritas expandidas
  ? 8 => tstr,                     ; detalhe
  ? 9 => bool,                     ; true: repetido pela deduplicação
  ? 10 => [* [sid, value]],        ; CALL: propostas da expansão (para renovar o lease)
  * uint => any
}
result-state = &(ok: 0, err: 1, running: 2, cancelled: 3) / uint

; ----------------------------------------------------------------- CANCEL 0x18
cancel = { 1 => u32, * uint => any }

; ----------------------------------------------------------------- EVENTS 0x19
events = { 1 => mono-us, 2 => [* event], ? 3 => u32, * uint => any }
event = [eid: u16, dt: u32, data: record / null, ? flags: uint, * any]

; ----------------------------------------------------------------- ALARMS 0x1A
alarms = { 1 => mono-us, 2 => [* alarm-tr], ? 3 => bool, ? 4 => u32, * uint => any }
alarm-tr = [
  alid: u16,
  state: alarm-state,
  dt: u32,
  ? flags: uint,                   ; bit 0 uncertain, bit 1 shelved, bit 2 suppressed
  * any
]

; -------------------------------------------------------------- ALARM_CMD 0x1B
alarm-cmd = {
  1 => u32,                        ; id do pedido
  2 => u16,                        ; alid
  3 => &(ack: 0, shelve: 1, unshelve: 2) / uint,
  ? 4 => dur-ms,                   ; ttl (obrigatório em shelve)
  5 => role,
  * uint => any
}

; ------------------------------------------------------------------ RESET 0x1C
reset = { 1 => u32, 2 => sid, 3 => role, * uint => any }

; ---------------------------------------------------------------- RESTART 0x1D
restart = { 1 => u32, 2 => &(warm: 0, reboot: 1) / uint, 3 => role, * uint => any }

; ------------------------------------------------------------------- TIME 0x20
time = time-probe / time-echo / time-set
time-probe = { 1 => 0, 2 => host-us, * uint => any }                       ; t1
time-echo  = { 1 => 1, 2 => host-us, 3 => mono-us, 4 => mono-us, * uint => any } ; t1, t2, t3
time-set   = {
  1 => 2,
  5 => mono-us,                    ; instante M do MCU
  6 => utc-us,                     ; UTC em M
  7 => clock-quality,
  8 => clock-source,
  ? 9 => i32,                      ; correção de taxa do relógio do MCU, ppb
  ? 10 => u32,                     ; erro estimado, µs
  ? 11 => dur-ms,                  ; max_holdover
  ? 12 => utc-us,                  ; holdover desde (quando 7 = holdover)
  * uint => any
}

; ------------------------------------------------------------------ TRACE 0x21
trace = trace-list / trace-info / trace-read / trace-data / trace-release / trace-freeze
trace-list    = { 1 => 0, * uint => any }
trace-info    = { 1 => 1, 2 => [* seg-info], * uint => any }
trace-read    = { 1 => 2, 3 => u16, 4 => u32, 5 => u16, * uint => any }    ; seg, offset, len
trace-data    = { 1 => 3, 3 => u16, 4 => u32, 6 => bstr, 7 => bool, * uint => any }
trace-release = { 1 => 4, 3 => u16, * uint => any }
trace-freeze  = { 1 => 5, * uint => any }
seg-info = [
  seg: u16,
  reason: &(continuous: 0, trip: 1, manual: 2, crash: 3) / uint,
  size: u32,
  frozen: mono-us / null,
  * any
]

; -------------------------------------------------------------------- OTA 0x22
ota = ota-begin / ota-ready / ota-data / ota-ack / ota-end / ota-verified /
      ota-activate / ota-confirm / ota-abort / ota-state
ota-kind = &(generation: 1, firmware: 2, model: 3, app: 4) / uint   ; 0 nunca; 3, 4: RESERVADOS 1.4

ota-begin    = { 1 => 0, 2 => u16, 3 => ota-kind, 4 => u32,
                 5 => bstr .cbor COSE_Sign1_Tagged, ? 6 => u16, * uint => any }
ota-ready    = { 1 => 1, 2 => u16, 6 => u16, 7 => u32, 8 => u8, * uint => any }
ota-data     = { 1 => 2, 2 => u16, 7 => u32, 9 => bstr, * uint => any }
ota-ack      = { 1 => 3, 2 => u16, 7 => u32, * uint => any }
ota-end      = { 1 => 4, 2 => u16, * uint => any }
ota-verified = { 1 => 5, 2 => u16, 10 => status, * uint => any }
ota-activate = { 1 => 6, 2 => u16, 11 => dur-ms, * uint => any }
ota-confirm  = { 1 => 7, 3 => ota-kind, * uint => any }
ota-abort    = { 1 => 8, 2 => u16, 10 => status, ? 12 => tstr, * uint => any }
ota-state    = { 1 => 9, 3 => ota-kind, 13 => gen-state, * uint => any }

; Manifesto assinado (payload do COSE_Sign1)
ota-manifest = {
  1 => ota-kind,
  2 => tstr,                       ; alvo (família de firmware / placa)
  3 => tstr,                       ; versão (SemVer no firmware; gen decimal na geração)
  4 => u32,                        ; tamanho da imagem
  5 => hash32,                     ; SHA-256 da imagem
  6 => u32,                        ; security_version (firmware: contador anti-rollback; geração: 0)
  ? 7 => u64,                      ; gen_seq (geração; anti-rollback da geração)
  ? 8 => hash32,                   ; hash da geração (source_hash do blob)
  ? 9 => hash32,                   ; hash das capacidades do firmware alvo (ref/08 §2.14)
  ? 10 => utc-us,                  ; criado em
  ? 11 => link-version,            ; versão mínima do Joker Link
  ? 12 => bstr .size 8,            ; board_id (geração; = cabeçalho do blob)
  ? 13 => u16,                     ; format do blob (geração)
  ? 14 => tstr,                    ; nó a que o blob está ligado (NODE_BOUND)
  ? 15 => hash32,                  ; registry_hash (geração)
  * uint => any
}
; Numa geração, este COSE_Sign1 é também o trailer do blob .jkgen (ref/08 §2.13.5): uma só forma.

; COSE_Sign1 (RFC 9052) restrito a EdDSA/Ed25519
COSE_Sign1_Tagged = #6.18(COSE_Sign1)
COSE_Sign1 = [
  protected:   bstr .cbor cose-protected,
  unprotected: { * (int / tstr) => any },
  payload:     bstr .cbor ota-manifest,
  signature:   bstr .size 64
]
cose-protected = { 1 => -8, 4 => kid16, * (int / tstr) => any }   ; alg EdDSA, kid de 16 B

; ============================================================ CATÁLOGO (§6.2)
; Bytes transferidos por CATALOG; SHA-256 destes bytes = hash do catálogo.
catalog = {
  1 => [* signal-desc],
  ? 2 => [* instance-desc],
  ? 3 => [* method-desc],
  ? 4 => [* action-desc],
  ? 5 => [* event-desc],
  ? 6 => [* alarm-desc],
  ? 7 => [* group-desc],
  8 => tstr,                       ; nome do MCU
  * uint => any
}
signal-desc = {
  1 => sid,
  2 => tstr,                       ; caminho no MCU (02 §9)
  3 => sig-type,
  4 => tstr,                       ; unidade (catálogo do 16 §5; "1" = adimensional)
  5 => &(input: 0, output: 1, internal: 2, param: 3, derived: 4) / uint,
  ? 6 => u16,                      ; gid do grupo dono
  ? 7 => [* [u64, tstr]],          ; enum: variantes; bits: nomes dos bits
  ? 8 => u16,                      ; saídas: níveis delegados ao link (bit L-1)
  ? 9 => [value, value],           ; saídas: range (informativo)
  ? 10 => value / "relinquish",    ; saídas: safe (informativo)
  ? 11 => dur-ms,                  ; max_age no MCU
  ? 12 => tstr,                    ; grandeza (16 §5)
  ? 13 => u8,                      ; largura N de bits<N> / enum<N>
  * uint => any
}
instance-desc = {
  1 => u32,                        ; iid
  2 => tstr,                       ; nome da instância no MCU
  3 => tstr,                       ; classe ("std/pump@1")
  4 => tstr,                       ; versão completa ("1.2.0")
  5 => hash32,                     ; hash do contrato (17 §6)
  ? 6 => [* tstr],                 ; capacidades
  7 => [* [member: tstr, sid]],
  ? 8 => [* [member: tstr, [* u32]]],   ; class members (17 §8): iids, in collection order
  ? 9 => bool,                     ; true: only a member, no top-level name on the node (ref/07 §8.3)
  * uint => any
}
method-desc = { 1 => u16, 2 => tstr, 3 => u32, ? 4 => bool, * uint => any }   ; mid, caminho, iid, atomic
action-desc = { 1 => u16, 2 => tstr, ? 3 => u32, 4 => role, 5 => dur-ms, ? 6 => bool, * uint => any } ; aid, caminho, iid, papel, timeout, long
event-desc  = { 1 => u16, 2 => tstr, ? 3 => u32, ? 4 => [* [tstr, sig-type, tstr]], * uint => any }
alarm-desc  = { 1 => u16, 2 => tstr, 3 => severity, ? 4 => tstr, ? 5 => sid, * uint => any }
group-desc  = { 1 => u16, 2 => tstr, 3 => u32, * uint => any }   ; gid, nome, período em µs
