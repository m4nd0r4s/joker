[Unit]
Description=Joker runtime
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=10
ExecStart=/usr/local/bin/jokerd --state-dir /var/lib/joker --manifest /etc/joker/joker.toml --board /etc/joker/board.toml
Restart=on-failure
RestartSec=2
LimitMEMLOCK=infinity
LimitRTPRIO=99
StateDirectory=joker
RuntimeDirectory=joker

[Install]
WantedBy=multi-user.target
